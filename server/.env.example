# Server Configuration
PORT=3001
NODE_ENV=production

# Admin Authentication
ADMIN_USERNAME=admin
# Use hashed password in production (generate with: node -e "const bcrypt = require('bcrypt'); console.log(bcrypt.hashSync('your-password', 10))")
#ADMIN_PASSWORD_HASH=$2b$10$...
# Or use plaintext password (not recommended for production)
ADMIN_PASSWORD=admin123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Google OAuth (for Student Login)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=293988143979-rtcthtuh2rj03gsjrb0e1itjf1hftsct.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Production (with reverse proxy - HTTP only, no SSL)
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# MongoDB Configuration (Production)
MONGODB_URI=mongodb://admin:admin123@localhost:27017/hcmute_exam?authSource=admin

# CORS Configuration (comma-separated)
# Production (with reverse proxy - same domain)
CORS_ORIGIN=http://localhost:3000

# Frontend URL (for OAuth redirect)
# Production (with reverse proxy - same domain)
FRONTEND_URL=http://localhost:3000

